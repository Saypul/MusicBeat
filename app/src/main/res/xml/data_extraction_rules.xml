<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="musicbeat_auth.xml" />
        <exclude domain="sharedpref" path="musicbeat_auth_plain.xml" />
        <exclude domain="sharedpref" path="musicbeat_sources.xml" />
        <exclude domain="sharedpref" path="musicbeat_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="musicbeat_last_played.xml" />
        <exclude domain="sharedpref" path="musicbeat_bounded_context.xml" />
        <exclude domain="sharedpref" path="musicbeat_party_queue_stash.xml" />
        <!-- WebView cookies and storage: the live Google, Spotify and Discord login sessions. -->
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="musicbeat_auth.xml" />
        <exclude domain="sharedpref" path="musicbeat_auth_plain.xml" />
        <exclude domain="sharedpref" path="musicbeat_sources.xml" />
        <exclude domain="sharedpref" path="musicbeat_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="musicbeat_last_played.xml" />
        <exclude domain="sharedpref" path="musicbeat_bounded_context.xml" />
        <exclude domain="sharedpref" path="musicbeat_party_queue_stash.xml" />
        <!-- WebView cookies and storage: the live Google, Spotify and Discord login sessions. -->
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
