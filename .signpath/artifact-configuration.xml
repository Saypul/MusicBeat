<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows" for the MusicBeat desktop build.
  The input is the GitHub artifact the desktop-windows workflow uploads, which
  GitHub delivers as a zip holding the three Windows packages.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MusicBeat-*-windows-x64-setup.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
    <msi-file path="MusicBeat-*-windows-x64.msi" max-matches="1">
      <authenticode-sign />
    </msi-file>
    <zip-file path="MusicBeat-*-windows-x64-portable.zip" max-matches="1">
      <pe-file path="MusicBeat/MusicBeat.exe">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
